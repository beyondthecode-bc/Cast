  <string key="help.shortcut.home">Retour à l'accueil</string>
  <string key="help.number.kicker">Entier aléatoire</string>
  <string key="help.number.tagline">Choisissez un entier entre Min et Max (inclus).</string>
  <string key="help.number.step1">Saisissez Min et Max. Lancez pour tirer un nombre dans la plage.</string>
  <string key="help.number.step2">Touchez le grand chiffre pour le copier dans le presse-papiers.</string>
  <string key="help.number.step3">Activez « Unique dans la session » pour éviter les doublons.</string>
  <string key="help.number.tip1">Quand les valeurs uniques sont épuisées, un bouton Réinitialiser apparaît.</string>
  <string key="help.number.tip2">Les plages négatives sont prises en charge — p. ex. -10 … 10.</string>
  <string key="help.dice.kicker">Lancer polyédrique</string>
  <string key="help.dice.tagline">Lancez 1 à 6 dés de toute forme standard (D4 – D100).</string>
  <string key="help.dice.step1">Choisissez Faces et Nombre. Lancez pour tirer tous les dés à la fois.</string>
  <string key="help.dice.step2">Le résultat montre les lancers individuels et le total.</string>
  <string key="help.dice.step3">Touchez la zone de résultat pour copier un résumé formaté.</string>
  <string key="help.dice.tip1">Les gros dés tournent davantage — ajustez l'animation dans les Réglages.</string>
  <string key="help.coin.kicker">50/50 équitable</string>
  <string key="help.coin.tagline">Lancez une pièce cryptographiquement équitable : Pile ou Face.</string>
  <string key="help.coin.step1">Appuyez sur Lancer. La pièce tourne, puis révèle son côté.</string>
  <string key="help.coin.step2">Touchez le résultat pour copier « Pile » ou « Face ».</string>
  <string key="help.coin.tip1">Aucun biais sur la durée — adapté aux vrais tirages au sort.</string>
  <string key="help.picker.kicker">Un parmi plusieurs</string>
  <string key="help.picker.tagline">Choisit un élément au hasard dans votre liste.</string>
  <string key="help.picker.step1">Saisissez vos éléments — un par ligne — dans l'éditeur.</string>
  <string key="help.picker.step2">Lancez pour les faire défiler et en choisir un.</string>
  <string key="help.picker.step3">Touchez le résultat pour copier uniquement l'élément choisi.</string>
  <string key="help.picker.tip1">Les lignes en double sont pondérées — ajoutez un nom deux fois pour doubler ses chances.</string>
  <string key="help.password.kicker">Basé sur CSPRNG</string>
  <string key="help.password.tagline">Générez un mot de passe sécurisé à partir des classes activées.</string>
  <string key="help.password.step1">Réglez la Longueur (8 – 64) avec le curseur.</string>
  <string key="help.password.step2">Activez les puces A / a / 1 / !@# selon les classes voulues.</string>
  <string key="help.password.step3">Lancez pour générer. Touchez pour copier — le mot de passe n'est jamais enregistré.</string>
  <string key="help.password.tip1">« Exclure les caractères ambigus » retire 0, O, 1, l, I, | pour éviter les confusions.</string>
  <string key="help.password.tip2">Au moins une classe doit rester activée — la dernière se verrouille seule.</string>
  <string key="help.color.kicker">Spectre complet</string>
  <string key="help.color.tagline">Génère une couleur aléatoire, formatée pour le copier-coller.</string>
  <string key="help.color.step1">Choisissez HEX, RGB ou HSL avec le sélecteur de format.</string>
  <string key="help.color.step2">Lancez pour tirer une nouvelle couleur — l'échantillon remplit la zone.</string>
  <string key="help.color.step3">Touchez l'échantillon pour copier la valeur au format choisi.</string>
  <string key="help.color.tip1">La couleur du texte bascule entre noir et blanc selon la luminance.</string>
  <string key="help.shuffle.kicker">Réorganiser la liste</string>
  <string key="help.shuffle.tagline">Renvoie votre liste dans un ordre aléatoire. Il faut au moins 2 éléments.</string>
  <string key="help.shuffle.step1">Saisissez vos éléments — un par ligne — dans l'éditeur.</string>
  <string key="help.shuffle.step2">Lancez pour les éparpiller dans un nouvel ordre.</string>
  <string key="help.shuffle.step3">Touchez le résultat pour copier toute la liste, jointe par des retours à la ligne.</string>
  <string key="help.shuffle.tip1">Utilise un mélange Fisher–Yates avec un RNG sécurisé.</string>
